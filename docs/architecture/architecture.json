  "cards": [
    {
      "dot": "cyan",
      "title": "Private runtime",
      "items": [
        "Route53 lab.internal aliases → internal ALB (alb_ready=true). ACM terminates TLS; ALB also routes Argo CD and Grafana.",
        "Frontend polls GET /value every 5s. Seed PostSync Job initializes RDS. Backend reads the RDS-managed secret using IRSA."
      ]
    },
    {
      "dot": "amber",
      "title": "Network & delivery",
      "items": [
        "Public subnet: fck-nat t4g.micro + internet gateway. Private outbound GitHub traffic uses NAT; AWS APIs use interface endpoints and S3 gateway.",
        "CodeBuild requires github_token_ready. Release updates Chart.yaml with [skip ci]; ECR cache/mirrors serve platform images."
      ]
    },
    {
      "dot": "emerald",
      "title": "Configuration, not live status",
      "items": [
        "Sources: Terraform 10–70, Helm charts/lab, pipeline/buildspec.yml, gitops/ and README.",
        "Logical groupings are not subnet placement for managed AWS services. EKS API public access is configurable; RDS remains private and single AZ."
      ]
    }
  ]
